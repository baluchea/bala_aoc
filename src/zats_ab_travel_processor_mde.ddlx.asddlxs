@Metadata.layer: #CUSTOMER
@UI.headerInfo: {
    typeName: 'Travel Request',
    typeNamePlural: 'Travel requests',
    title:{value: 'TravelId'},
    description: {
        value: 'Description'  
    }   
    }

annotate entity ZATS_AB_TRAVEL_PROCESSOR
    with 
{
    @UI.facet: [{
        purpose:#HEADER,
        id:'TravelheaderPrice',
        type:#DATAPOINT_REFERENCE,
        position:10,
        targetQualifier: 'HeaderPrice'
    },
    
     {
        purpose:#HEADER,
        id:'OverAllPrice',
        type:#DATAPOINT_REFERENCE,
        position:20,
        targetQualifier: 'OverlAllStatus'
    },
    
    {
        purpose:#STANDARD,
        id:'IdGenInfo',
        type:#COLLECTION,
        position:10,
        label:'General Information'
    },
    
    {
        purpose:#STANDARD,
        id:'Basic',
        type:#IDENTIFICATION_REFERENCE,
        position:10,
        parentId: 'IdGenInfo',
        label:'Basic Information'
    },
    {
        purpose:#STANDARD,
        id:'Iddates',
        type:#FIELDGROUP_REFERENCE,
        position:20,
        parentId: 'IdGenInfo',
        label:'Travel Dates',
        targetQualifier: 'spiderman'
    },
    {
        purpose:#STANDARD,
        id:'IdPrices',
        type:#FIELDGROUP_REFERENCE,
        position:30,
        parentId: 'IdGenInfo',
        label:'Costs',
        targetQualifier: 'superman'
    },
    {
        purpose:#STANDARD,
        id:'IdItem',
        type:#LINEITEM_REFERENCE,
        position:20,
        label:'Bookings',
        targetElement: '_Booking'
    }    
    
    ]
    
    @UI.selectionField: [{ position:10 }]
    @UI.lineItem: [{ position:10 }]
    @UI.identification:[{position:10}]
    TravelId;
    @UI.selectionField: [{ position:20 }]
    @UI.lineItem: [{ position:20 }]
    @UI.identification:[{position:30}]
    AgencyId;
    @UI.selectionField: [{ position:30 }]
    @UI.lineItem: [{ position:30 }]
    @UI.identification:[{position:40}]
    CustomerId;
    @UI.lineItem: [{ position:40 }]
    @UI.fieldGroup: [{ position:10,qualifier: 'spiderman' }]
    BeginDate;
    @UI.fieldGroup: [{ position:20,qualifier: 'spiderman' }]
    EndDate;
    @UI.fieldGroup: [{ position:10,qualifier: 'superman' }]
    BookingFee;
    @UI.selectionField: [{ position:40 }]
    @UI.lineItem: [{ position:50 }]
    @UI.dataPoint:{qualifier: 'HeaderPrice',title:'Total Price'}
    @UI.fieldGroup: [{ position:20,qualifier: 'superman' }]
    TotalPrice;
    @UI.fieldGroup: [{ position:20,qualifier: 'superman' }]
    CurrencyCode;
    @UI.identification:[{position:30}]
    Description;
    @UI.selectionField: [{ position:50 }]
    @UI.lineItem: [{ position:60, importance:#HIGH,criticality: 'Minion'}]
    @UI.dataPoint:{qualifier: 'OverlAllStatus',title:'Travel Status'}
    @UI.fieldGroup: [{ position:30,qualifier: 'spiderman' }]
    OverallStatus;
//    CreatedBy;
//    CreatedAt;
//    LastChangedBy;
//    LastChangedAt;

    
}